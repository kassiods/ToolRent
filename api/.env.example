# Configuracao da API Java — ToolRent
# Copie para .env e preencha. O .env real NUNCA e commitado.
#
# Onde encontrar: painel do Supabase > Project Settings > Database

# Conexao JDBC com o Postgres do Supabase
SUPABASE_DB_URL=jdbc:postgresql://db.SEU-PROJETO.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=sua-senha-do-banco

# Validacao do JWT emitido pelo Supabase Auth (entra na Sprint 3)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_JWT_SECRET=cole-aqui-o-jwt-secret

# ATENCAO: a chave service_role fica SOMENTE aqui, na API.
# Se ela chegar ao app Flutter, qualquer usuario tera acesso
# irrestrito ao banco.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role

# Porta local da API
API_PORT=8080
