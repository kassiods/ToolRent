# Configuracao da API Java — ToolRent
# Copie para .env e preencha. O .env real NUNCA e commitado.
#
# IMPORTANTE: o Spring NAO le .env sozinho. Depois de preencher, carregue
# as variaveis no terminal ANTES de rodar a API:
#   PowerShell:
#     Get-Content .env | ForEach-Object { $p = $_.Split('=', 2); if ($p.Count -eq 2) { Set-Item "env:$($p[0])" $p[1] } }
#   bash:
#     set -a; . ./.env; set +a

# --- Conexao JDBC com o Postgres (SESSION POOLER) -----------------
# Painel > Connect > Connection string > Session pooler > URI
# Troque o prefixo postgresql:// por jdbc:postgresql://
# Usuario pooler: postgres.<REF-DO-PROJETO> (com ponto, NUNCA so "postgres")
# NAO use o hostname antigo db.<ref>.supabase.co: ele nao existe em
# projetos novos e o DNS falha com UnknownHostException.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-SEU-REGIAO.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.SEU-REF-DO-PROJETO
SUPABASE_DB_PASSWORD=sua-senha-do-banco
# (senha em Project Settings > Database)

# --- Projeto Supabase ---------------------------------------------
# URL do projeto: origem do JWKS usado para validar o JWT (ES256).
# Painel > Project Settings > API > Project URL.
# A API NAO usa nenhuma chave para validar token: a validacao e feita
# com a chave publica em SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# --- Secret key (US02 — cadastro de login) -------------------------
# Painel > Project Settings > API Keys > secret key (sb_secret_…).
# Usada SO pela API para criar login no Supabase Auth (Admin API).
# NUNCA vai no app, NUNCA e commitada, NUNCA aparece em log.
# Se vazou: revogue no painel, nao apenas apague o valor.
SUPABASE_SECRET_KEY=sb_secret_SEU_VALOR

# Porta local da API
API_PORT=8080
