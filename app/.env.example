# Configuração do app Flutter — ToolRent
# Copie para .env e preencha. O .env real NUNCA é commitado.

# URL base da API Java (api/)
API_BASE_URL=http://localhost:8080

# Supabase — use SOMENTE a chave pública (anon).
# A chave service_role JAMAIS entra no app: ela daria acesso
# irrestrito ao banco a qualquer pessoa que abrisse o aplicativo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
