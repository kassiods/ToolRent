# Configuração do app Flutter — ToolRent
# Copie para .env e preencha. O .env real NUNCA é commitado.

# URL base da API Java (api/)
API_BASE_URL=http://localhost:8080

# Supabase — o app usa APENAS a chave pública (Publishable key).
# Painel > Project Settings > API Keys > Publishable key (sb_publishable_...).
# A secret key (service_role / sb_secret_...) JAMAIS entra no app: ela daria
# acesso irrestrito ao banco a qualquer pessoa que abrisse o aplicativo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_cole-aqui
